{
  "manifest_version": 3,
  "name": "Jarvis Browser Control",
  "description": "Lets the local Jarvis assistant control only the tabs in a dedicated JARVIS tab group.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "tabGroups", "scripting", "storage", "debugger", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Jarvis Browser Control",
    "default_popup": "popup.html"
  }
}
