# Copy to .env and fill in. Never commit .env.

# --- Main brain: any OpenAI-compatible provider -----------------------------
# One of: nvidia | groq | openrouter | gemini | ollama | custom
JARVIS_PROVIDER=nvidia
# Leave empty to use the provider's default model (see jarvis/llm/providers.py).
JARVIS_MODEL=
# Optional smaller/faster model on the same provider for cheap side jobs
# (summarising old context, extracting memories). Empty = use JARVIS_MODEL.
JARVIS_FAST_MODEL=
# Optional faster model for the voice/HUD frontends, where latency matters most.
# Empty = use the main model everywhere. Same provider as JARVIS_PROVIDER.
JARVIS_VOICE_MODEL=
# Seconds without any response bytes before a cloud request is abandoned and retried
# once (free-tier requests sometimes queue forever). 0 = never.
JARVIS_FIRST_BYTE_TIMEOUT=25

# Free API keys (set the one for your provider)
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# custom provider
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# --- Local option -----------------------------------------------------------
# Used when JARVIS_PROVIDER=ollama, with `jarvis --local`, or as the automatic
# fallback when the cloud provider is unreachable or rate limited.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Set false to never fall back to the local model.
JARVIS_LOCAL_FALLBACK=true
# Start `ollama serve` automatically when it is not running (localhost only).
JARVIS_OLLAMA_AUTOSTART=true

# --- Behaviour --------------------------------------------------------------
JARVIS_USER_NAME=
JARVIS_MAX_STEPS=25
JARVIS_TEMPERATURE=0.3
# Where memory and logs live. Empty = %LOCALAPPDATA%\Jarvis
JARVIS_DATA_DIR=

# --- Voice (uv sync --extra voice; run with: jarvis --voice) ----------------
JARVIS_WAKE_WORD=jarvis
JARVIS_REQUIRE_WAKE_WORD=true
JARVIS_FOLLOWUP_SECONDS=10
# vad = talking over Jarvis interrupts him (best with headphones)
# wake = only "jarvis ..." interrupts (use on laptop speakers) | off
JARVIS_BARGE_IN=vad
JARVIS_STT_MODEL=auto
JARVIS_STT_DEVICE=auto
JARVIS_TTS_VOICE=en_GB-alan-medium

# --- Scheduled tasks, proactive alerts, errands -------------------------------
# A one-off scheduled task missed by more than this many minutes is reported, not run.
JARVIS_TASK_GRACE_MINUTES=30
JARVIS_TASK_DEFER_MINUTES=10
JARVIS_TASK_MAX_STEPS=12
JARVIS_TASK_TIME_BUDGET=240
# Proactive alerts: on | off. No model call; one short sentence each.
JARVIS_PROACTIVE=on
JARVIS_WATCH_BATTERY=true
JARVIS_BATTERY_LOW=20
JARVIS_BATTERY_CRITICAL=10
JARVIS_WATCH_BATTERY_FULL=false
JARVIS_WATCH_DISK=true
JARVIS_DISK_LOW_GB=10
JARVIS_DISK_LOW_PERCENT=5
JARVIS_LONG_TURN_SECONDS=90
# No alerts in this window, e.g. 22:00-07:00. Empty = never quiet.
JARVIS_QUIET_HOURS=
# auto = Google when Chrome is connected, else the mail app / an .ics file
JARVIS_MAIL_PROVIDER=auto
JARVIS_CALENDAR_PROVIDER=auto
